# ==============================================================================
# AI-Based 2D to 3D NFT Creation & Cryptographic Provenance Platform
# Environment Configuration Template (.env.example)
#
# NOTE: This is a placeholder template. Do NOT commit actual secrets or private keys.
# ==============================================================================

# Backend Service
PROJECT_NAME="AI-Based 2D to 3D NFT Creation & Cryptographic Provenance Platform"
API_PREFIX="/api"

# Optional External Cloud AI 3D APIs (Meshy / Tripo3D)
# Leave empty to utilize the included offline Procedural Demo 3D Generator
MESHY_API_KEY=""
TRIPO3D_API_KEY=""

# Blockchain RPC Settings (Local Hardhat Node default: Chain ID 31337)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CHAIN_ID=31337

# Deployed Contract Address (Populated after deploying via 'npx hardhat run scripts/deploy.js')
CONTRACT_ADDRESS=""

# Deployer Private Key (Optional - for testnet deployment only, leave blank for local node)
DEPLOYER_PRIVATE_KEY=""

# Optional Public Testnet Configuration (e.g. Sepolia)
SEPOLIA_RPC_URL=""
PRIVATE_KEY=""
